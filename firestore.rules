
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Rule for dues: any signed-in user can read/write
    match /users/{userId}/dues/{dueId} {
      allow read, write: if isSignedIn();
    }
    
    // Rule for all other user documents (transactions, categories, budgets, etc.)
    // This rule path explicitly does not match the 'dues' subcollection path.
    match /users/{userId}/{collection}/{docId} {
      allow read, write: if isSignedIn() && isOwner(userId) && collection != 'dues';
    }
    
    // Rule for the user's top-level document
    match /users/{userId} {
       allow read, write: if isSignedIn() && isOwner(userId);
    }
  }
}
