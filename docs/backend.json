
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the Spends application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the User entity."
        },
        "email": {
          "type": "string",
          "description": "User's email address.",
          "format": "email"
        },
        "firstName": {
          "type": "string",
          "description": "User's first name."
        },
        "lastName": {
          "type": "string",
          "description": "User's last name."
        },
        "photoURL": {
          "type": "string",
          "description": "URL of the user's profile picture.",
          "format": "uri"
        }
      },
      "required": [
        "id",
        "email"
      ]
    },
    "Transaction": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Transaction",
      "type": "object",
      "description": "Represents a financial transaction.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Transaction entity."
        },
        "userId": {
          "type": "string",
          "description": "Reference to User. (Relationship: User 1:N Transaction)"
        },
        "categoryId": {
          "type": ["string", "null"],
          "description": "Reference to Category. (Relationship: Category 1:N Transaction)"
        },
        "transactionDate": {
          "type": "string",
          "description": "Date of the transaction.",
          "format": "date-time"
        },
        "amount": {
          "type": "number",
          "description": "Amount of the transaction."
        },
        "description": {
          "type": "string",
          "description": "Description of the transaction."
        },
        "transactionType": {
          "type": "string",
          "description": "Type of transaction (e.g., deposit, withdrawal)."
        },
        "isRecurring": {
          "type": "boolean",
          "description": "Whether the transaction is recurring."
        },
        "frequency": {
            "type": "string",
            "description": "Frequency of recurring transaction.",
            "enum": ["weekly", "monthly", "quarterly", "yearly"]
        },
        "recurrenceEndDate": {
            "type": "string",
            "description": "End date for the recurring transaction.",
            "format": "date-time"
        },
        "fileURL": {
          "type": "string",
          "description": "URL of an uploaded file attachment.",
          "format": "uri"
        },
        "fileName": {
            "type": "string",
            "description": "Name of the uploaded file."
        }
      },
      "required": [
        "id",
        "userId",
        "transactionDate",
        "amount",
        "description",
        "transactionType"
      ]
    },
    "Category": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Category",
      "type": "object",
      "description": "Represents a category for classifying transactions.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Category entity."
        },
        "userId": {
          "type": "string",
          "description": "Reference to User. (Relationship: User 1:N Category)"
        },
        "categoryName": {
          "type": "string",
          "description": "Name of the category (e.g., Food, Transportation)."
        },
        "categoryType": {
          "type": "string",
          "description": "Type of category (e.g., Income, Expense)."
        }
      },
      "required": [
        "id",
        "userId",
        "categoryName",
        "categoryType"
      ]
    },
    "Budget": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Budget",
      "type": "object",
      "description": "Represents a budget set by the user.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Budget entity."
        },
        "userId": {
          "type": "string",
          "description": "Reference to User. (Relationship: User 1:N Budget)"
        },
        "categoryId": {
          "type": "string",
          "description": "Reference to Category. (Relationship: Category 1:N Budget)"
        },
        "name": {
          "type": "string",
          "description": "Name of the budget."
        },
        "budgetAmount": {
          "type": "number",
          "description": "Amount allocated for the budget."
        },
        "budgetStartDate": {
          "type": "string",
          "description": "Start date of the budget.",
          "format": "date-time"
        },
        "budgetEndDate": {
          "type": "string",
          "description": "End date of the budget.",
          "format": "date-time"
        },
        "isRecurring": {
          "type": "boolean",
          "description": "Whether the budget is recurring."
        },
        "type": {
            "type": "string",
            "description": "Type of budget.",
            "enum": ["Bills", "Subscription", "Expense"]
        }
      },
      "required": [
        "id",
        "userId",
        "name",
        "budgetAmount",
        "budgetStartDate",
        "budgetEndDate",
        "isRecurring",
        "type"
      ]
    },
    "Due": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Due",
      "type": "object",
      "description": "Represents a due for bills or subscriptions.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Due entity."
        },
        "userId": {
          "type": "string",
          "description": "Reference to User. (Relationship: User 1:N Due)"
        },
        "dueName": {
          "type": "string",
          "description": "Name of the due."
        },
        "dueDate": {
          "type": "string",
          "description": "Date of the due.",
          "format": "date-time"
        },
        "dueAmount": {
          "type": "number",
          "description": "Amount due for the due."
        },
        "isPaid": {
          "type": "boolean",
          "description": "Whether the due has been paid."
        }
      },
      "required": [
        "id",
        "userId",
        "dueName",
        "dueDate",
        "dueAmount",
        "isPaid"
      ]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "Stores user profiles. Accessible only by the user themselves.",
          "params": [
            {
              "name": "userId",
              "description": "The unique identifier of the user."
            }
          ]
        }
      },
      {
        "path": "/users/{userId}/transactions/{transactionId}",
        "definition": {
          "entityName": "Transaction",
          "schema": {
            "$ref": "#/backend/entities/Transaction"
          },
          "description": "Stores transactions for a specific user. Accessible only by the user who owns the account.",
          "params": [
            {
              "name": "userId",
              "description": "The unique identifier of the user."
            },
            {
              "name": "transactionId",
              "description": "The unique identifier of the transaction."
            }
          ]
        }
      },
      {
        "path": "/users/{userId}/categories/{categoryId}",
        "definition": {
          "entityName": "Category",
          "schema": {
            "$ref": "#/backend/entities/Category"
          },
          "description": "Stores user-defined categories for transactions. Accessible only by the user themselves.",
          "params": [
            {
              "name": "userId",
              "description": "The unique identifier of the user."
            },
            {
              "name": "categoryId",
              "description": "The unique identifier of the category."
            }
          ]
        }
      },
      {
        "path": "/users/{userId}/budgets/{budgetId}",
        "definition": {
          "entityName": "Budget",
          "schema": {
            "$ref": "#/backend/entities/Budget"
          },
          "description": "Stores user's budgets. Accessible only by the user themselves.",
          "params": [
            {
              "name": "userId",
              "description": "The unique identifier of the user."
            },
            {
              "name": "budgetId",
              "description": "The unique identifier of the budget."
            }
          ]
        }
      },
      {
        "path": "/users/{userId}/dues/{dueId}",
        "definition": {
          "entityName": "Due",
          "schema": {
            "$ref": "#/backend/entities/Due"
          },
          "description": "Stores user's dues for bills and subscriptions. Accessible only by the user themselves.",
          "params": [
            {
              "name": "userId",
              "description": "The unique identifier of the user."
            },
            {
              "name": "dueId",
              "description": "The unique identifier of the due."
            }
          ]
        }
      }
    ],
    "reasoning": "The Firestore structure is designed to ensure data isolation and ownership based on the user. Each user has their own collection of transactions, categories, budgets, and dues. Transactions are stored as a subcollection of accounts, ensuring that transactions are always associated with a specific account owned by the user.\\n\\nThis design ensures Authorization Independence by storing all user-specific data under paths specific to the user's ID.  There are no dependencies on parent documents (no `get()` calls are needed in the rules). The database adheres to the principle that Rules are not Filters (QAPs). Data segregation by path enables secure `list` operations, as rules can simply verify that `request.auth.uid` matches the `userId` in the path. Because data is segregated by user ID, listing accounts, categories, and other entities will only return data for the authenticated user.\\n"
  }
}
